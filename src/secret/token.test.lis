import "go:os"
import "go:path/filepath"
import "go:strings"

#[test]
fn tokens_decode_hex_and_allow_a_single_final_newline() {
  let lower = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
  let upper = "0123456789ABCDEF0123456789ABCDEF0123456789ABCDEF0123456789ABCDEF"
  let assert Ok(decoded) = parse_token(f"{lower}\n".bytes())
  let assert Ok(other) = parse_token(f"{upper}\r\n".bytes())
  assert decoded.equals(other)
  for invalid in [
    "",
    "abc",
    f" {lower}",
    f"{lower}\n\n",
    f"z{lower.substring(1..)}",
  ] {
    assert parse_token(invalid.bytes()).is_err()
  }
}

#[test]
fn read_token_validates_paths_and_credential_names() -> Result<(), error> {
  let dir = os.MkdirTemp("", "vigilo-token-")?
  defer {
    let _ = os.RemoveAll(dir)
  }
  let nested = filepath.Join(dir, "creds")
  os.Mkdir(nested, 0o700)?
  let sample = strings.Repeat("a", 64)
  os.WriteFile(filepath.Join(dir, "outside"), sample.bytes(), 0o600)?
  os.WriteFile(filepath.Join(nested, "agent-token"), sample.bytes(), 0o600)?

  assert read_token(Source.File("relative-token"), "").is_err()
  assert read_token(Source.Credential("../outside"), nested).is_err()
  assert read_token(Source.Credential("agent-token"), nested).is_ok()
  Ok(())
}
