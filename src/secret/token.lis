import "go:crypto/sha256"
import "go:encoding/hex"
import "go:errors"

pub fn read_token(
  source: Source,
  credentials_dir: string,
) -> Result<Slice<byte>, error> {
  let contents = read(source, credentials_dir, "agent token", 64)?
  parse_token(contents)
}

fn parse_token(contents: Slice<byte>) -> Result<Slice<byte>, error> {
  decode_token(trim_final_newline(contents) as string)
}

pub fn decode_token(token: string) -> Result<Slice<byte>, error> {
  let invalid_token = errors.New(
    "agent token must contain exactly 64 hexadecimal characters",
  )
  if token.length() != 64 { return Err(invalid_token) }
  match hex.DecodeString(token) {
    Partial.Ok(data) => Ok(data),
    Partial.Err(_) | Partial.Both(_, _) => Err(invalid_token),
  }
}

pub fn digest_token(token: Slice<byte>) -> Array<byte, 32> {
  sha256.Sum256(token)
}
