import "go:bytes"
import "go:errors"
import "go:io"
import "go:os"
import "go:path/filepath"
import "go:strings"

pub enum Source {
  File(string),
  Credential(string),
}

pub fn validate(source: Source, field: string) -> Result<(), error> {
  match source {
    Source.File(path) => validate_absolute_path(path, f"{field}_file"),
    Source.Credential(name) => validate_credential(name).wrap_err(
      f"{field}_credential",
    ),
  }
}

pub fn read(
  source: Source,
  credentials_dir: string,
  label: string,
  limit: int64,
) -> Result<Slice<byte>, error> {
  let path = match source {
    Source.File(path) => {
      validate_absolute_path(path, label)?
      path
    },
    Source.Credential(name) => {
      validate_credential(name).wrap_err(label)?
      validate_absolute_path(credentials_dir, "CREDENTIALS_DIRECTORY")?
      filepath.Join(credentials_dir, name)
    },
  }
  let file = os.Open(path).wrap_err(f"open {label}")?
  defer file.Close()
  // allow a final CRLF and one byte so oversize input cannot look valid.
  match io.ReadAll(io.LimitReader(file, limit + 3)) {
    Partial.Ok(data) => Ok(data),
    Partial.Err(err) | Partial.Both(_, err) => Err(err).wrap_err(
      f"read {label}",
    ),
  }
}

pub fn trim_final_newline(contents: Slice<byte>) -> Slice<byte> {
  bytes
    .CutSuffix(contents, "\r\n".bytes())
    .unwrap_or_else(|| bytes.TrimSuffix(contents, "\n".bytes()))
}

pub fn validate_absolute_path(path: string, field: string) -> Result<(), error> {
  if !filepath.IsAbs(path) || strings.ContainsRune(path, '\0') {
    return Err(errors.New(f"{field} must be an absolute path without NUL"))
  }
  Ok(())
}

fn validate_credential(name: string) -> Result<(), error> {
  if name == "" || name == "." || name == ".." {
    return Err(errors.New("expected a credential name"))
  }
  let allowed = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._-"
  if strings.ContainsFunc(name, |ch| !strings.ContainsRune(allowed, ch)) {
    return Err(errors.New(
      "credential names may contain only ASCII letters, digits, dots, underscores, and hyphens",
    ))
  }
  Ok(())
}
