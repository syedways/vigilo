import "go:os"
import "go:path/filepath"
import "go:strings"

import "server"

fn minimal_server() -> string {
  "[server.admin]\nusername = \"admin\"\npassword_file = \"/missing/password\"\n"
}

#[test]
fn server_defaults_and_secret_source() {
  let assert Ok(Config.Server(settings)) = parse(minimal_server().bytes())
  assert settings.listen == "127.0.0.1:8080"
  assert settings.tls.is_none()
  assert settings.storage_path == "/var/lib/vigilo/vigilo.db"
  let assert server.AuthConfig.Password { username, source } = settings.auth
  assert username == "admin"
  assert source == server.SecretSource.File("/missing/password")
}

#[test]
fn full_server_config() {
  let contents = "[server]
listen = \"[::1]:9000\"
[server.storage]
path = \"/srv/vigilo/state.db\"
[server.admin]
username = \"operator\"
password_credential = \"admin-password.1\"
"
  let assert Ok(Config.Server(settings)) = parse(contents.bytes())
  assert settings.listen == "[::1]:9000"
  assert settings.storage_path == "/srv/vigilo/state.db"
  let assert server.AuthConfig.Password { username, source } = settings.auth
  assert username == "operator"
  assert source == server.SecretSource.Credential("admin-password.1")
}

#[test]
fn minimal_agent_config() {
  let assert Ok(Config.Agent(settings)) = parse(
    "[agent]\nname = \"web-01\"\n".bytes(),
  )
  assert settings.machine_name == "web-01"
}

#[test]
fn config_sections_support_one_or_both_roles() {
  let server_section = "[server.admin]\nusername = \"admin\"\npassword_credential = \"admin-password\"\n"
  let agent_section = "[agent]\nname = \"web-01\"\n"
  let assert Ok(Config.Server(server_only)) = parse(server_section.bytes())
  let assert Ok(Config.Agent(agent_only)) = parse(agent_section.bytes())
  let assert Ok(Config.Both { server: shared_server, agent: shared_agent }) = parse(
    f"[server]\nlisten = \"[::1]:9000\"\n{server_section}[server.storage]\npath = \"/srv/vigilo/state.db\"\n{agent_section}".bytes(),
  )
  assert server_only.listen == "127.0.0.1:8080"
  assert server_only.storage_path == "/var/lib/vigilo/vigilo.db"
  assert shared_server.listen == "[::1]:9000"
  assert shared_server.storage_path == "/srv/vigilo/state.db"
  let assert server.AuthConfig.Password { username, source } = shared_server.auth
  assert username == "admin"
  assert source == server.SecretSource.Credential("admin-password")
  assert agent_only.machine_name == "web-01"
  assert shared_agent.machine_name == agent_only.machine_name
}

#[test]
fn shared_configs_reject_invalid_sections() {
  let server_section = "[server.admin]\nusername = \"admin\"\npassword_file = \"/missing/password\"\n"
  let agent_section = "[agent]\nname = \"web-01\"\n"
  for contents in [
    f"{server_section}[agent]\n",
    f"[server]\n{agent_section}",
    f"[server]\nlisten = \"bad\"\n{server_section}{agent_section}",
    f"{server_section}password_credential = \"\"\n{agent_section}",
    f"{server_section}{agent_section}Name = \"alias\"\n",
    f"{server_section}{agent_section}unknown = true\n",
    "agent = []",
    "server = true",
  ] {
    assert parse(contents.bytes()).is_err()
  }
}

#[test]
fn rejects_missing_sections_and_legacy_roles() {
  let assert Err(missing) = parse("".bytes())
  assert missing.Error().contains("config requires a server or agent section")
  for contents in [
    "role = \"server\"\n[admin]\nusername = \"admin\"\npassword_file = \"/missing/password\"\n",
    "role = \"agent\"\n[machine]\nname = \"web-01\"\n",
    f"role = \"server\"\n{minimal_server()}",
  ] {
    let assert Err(err) = parse(contents.bytes())
    assert err.Error().contains("unknown config field")
  }
}

#[test]
fn rejects_unknown_fields() {
  for contents in [
    f"unknown = true\n{minimal_server()}",
    f"{minimal_server()}unknown = true\n",
    f"{minimal_server()}[machine]\nname = \"web\"\n",
    f"{minimal_server()}[unused]\n",
    "[agent]\nname = \"web\"\nunknown = true\n",
    "[agent]\nname = \"web\"\n[agent.admin]\n",
  ] {
    let assert Err(err) = parse(contents.bytes())
    assert err.Error().contains("decode")
  }
}

#[test]
fn config_errors_do_not_echo_unknown_literal_secrets() {
  for (literal, secret) in [
    ("\"test-secret-must-stay-private\"", "test-secret-must-stay-private"),
    ("123456789123456789123456789", "123456789123456789123456789"),
    ("0xffffffffffffffffffffffff", "ffffffffffffffffffffffff"),
    ("1.23456789123456789e9999", "1.23456789123456789e9999"),
    ("test-secret-must-stay-private", "test-secret-must-stay-private"),
  ] {
    let contents = f"{minimal_server()}password = {literal}\n"
    let assert Err(err) = parse(contents.bytes())
    assert !err.Error().contains(secret)
    assert !err.Error().contains("password =")
  }
}

#[test]
fn rejects_mixed_case_keys_and_aliases() {
  for contents in [
    f"{minimal_server()}Password_Credential = \"admin-password\"\n",
    f"{minimal_server()}Password_File = \"/different/password\"\n",
    strings.ReplaceAll(minimal_server(), "password_file", "Password_File"),
    strings.ReplaceAll(minimal_server(), "[server.admin]", "[server.Admin]"),
    f"{minimal_server()}[server.Admin]\npassword_credential = \"admin-password\"\n",
    strings.ReplaceAll(minimal_server(), "[server.admin]", "[Server.admin]"),
    f"{minimal_server()}[server]\nlisten = \"127.0.0.1:8080\"\nListen = \"0.0.0.0:8080\"\n",
    "server = { admin = { username = \"admin\", password_file = \"/missing/password\", Password_Credential = \"admin-password\" } }\n",
    "[agent]\nname = \"web-01\"\nName = \"web-02\"\n",
    "[Agent]\nname = \"web-01\"\n",
  ] {
    let assert Err(err) = parse(contents.bytes())
    assert err.Error().contains("config keys must be lowercase")
  }
}

#[test]
fn decode_errors_keep_safe_context() {
  let assert Err(syntax_err) = parse("[agent]\nname =".bytes())
  assert syntax_err.Error().contains("decode TOML")
  assert syntax_err.Error().contains("line 2, column")
  let assert Err(type_err) = parse("[agent]\nname = 1\n".bytes())
  assert type_err.Error().contains("decode config sections")
  assert type_err.Error().contains("invalid TOML")
  assert type_err.Error().contains("line 2, column")
  let assert Err(field_err) = parse(
    f"{minimal_server()}unknown = true\n".bytes(),
  )
  assert field_err.Error().contains("unknown config field")
}

#[test]
fn rejects_missing_and_invalid_values() {
  for contents in [
    "[server]\n",
    "[agent]\n",
    "[agent]\nname = \"  \"\n",
    "[agent]\nname = 1\n",
    strings.ReplaceAll(
      minimal_server(),
      "username = \"admin\"",
      "username = \"\"",
    ),
    strings.ReplaceAll(
      minimal_server(),
      "/missing/password",
      "relative/password",
    ),
    f"{minimal_server()}[server.storage]\npath = \"relative.db\"\n",
    f"{minimal_server()}[server.storage]\npath = \"\"\n",
  ] {
    assert parse(contents.bytes()).is_err()
  }
}

#[test]
fn requires_exactly_one_nonempty_secret_selector() {
  for contents in [
    "[server.admin]\nusername = \"admin\"\n",
    f"{minimal_server()}password_credential = \"admin-password\"\n",
    f"{minimal_server()}password_credential = \"\"\n",
    strings.ReplaceAll(minimal_server(), "/missing/password", ""),
    strings.ReplaceAll(
      minimal_server(),
      "password_file = \"/missing/password\"",
      "password_credential = \"\"",
    ),
  ] {
    assert parse(contents.bytes()).is_err()
  }
}

#[test]
fn auth_modes_require_a_loopback_listener_and_exclusive_settings() {
  let assert Ok(Config.Server(settings)) = parse(
    "[server]\nauth = \"none\"\nlisten = \"[::1]:8080\"\n".bytes(),
  )
  let assert server.AuthConfig.Disabled = settings.auth

  for contents in [
    "[server]\nauth = \"password\"\n",
    "[server]\nauth = \"\"\n",
    "[server]\nauth = \"unknown\"\n",
    f"[server]\nauth = \"none\"\n{minimal_server()}",
    "[server]\nauth = \"none\"\n[server.admin]\n",
    "[server]\nauth = \"none\"\nlisten = \"0.0.0.0:8080\"\n",
    "[server]\nauth = \"none\"\nlisten = \"[::]:8080\"\n",
    f"[server]\nlisten = \"192.0.2.1:8080\"\n{minimal_server()}",
    strings.ReplaceAll(minimal_server(), "admin\"", "admin:operator\""),
  ] {
    assert parse(contents.bytes()).is_err()
  }
}

#[test]
fn tls_allows_remote_password_auth_and_requires_both_paths() {
  let tls = "[server.tls]\ncertificate_file = \"/missing/cert.pem\"\nkey_file = \"/missing/key.pem\"\n"
  let remote = "[server]\nlisten = \"0.0.0.0:8443\"\n"
  let assert Ok(Config.Server(settings)) = parse(
    f"{remote}{minimal_server()}{tls}".bytes(),
  )
  let assert Some(files) = settings.tls
  assert files.certificate_file == "/missing/cert.pem"
  assert files.key_file == "/missing/key.pem"

  for invalid in [
    "[server.tls]\n",
    "[server.tls]\ncertificate_file = \"/missing/cert.pem\"\n",
    "[server.tls]\nkey_file = \"/missing/key.pem\"\n",
    strings.ReplaceAll(tls, "/missing/cert.pem", "cert.pem"),
    strings.ReplaceAll(tls, "/missing/key.pem", "key.pem"),
  ] {
    assert parse(f"{minimal_server()}{invalid}".bytes()).is_err()
  }
  let assert Err(err) = parse(f"{remote}auth = \"none\"\n{tls}".bytes())
  assert err.Error().contains("must use a loopback IP when auth is none")
}

#[test]
fn http_checks_accept_named_tables_and_reject_invalid_settings() {
  let config = "[server]\nauth = 'none'\n[server.checks.site]\n"
  let assert Ok(Config.Server(settings)) = parse(
    f"{config}url = 'https://example.test/health'\ninterval = '30s'\n[server.checks.other-site]\nurl = 'http://127.0.0.1:8080/'\n".bytes(),
  )
  assert settings.checks.length() == 2
  assert settings.checks.get("site").is_some()
  assert settings.checks.get("other-site").is_some()

  for settings in [
    "",
    "url = 'ftp://example.test/'\n",
    "url = 'http:///health'\n",
    "url = 'http://user:example-secret@example.test/'\n",
    "url = 'https://example.test/#health'\n",
    "url = 'https://example.test/'\ninterval = '500ms'\n",
    "url = 'https://example.test/'\ninterval = 'tomorrow'\n",
    "url = 'https://example.test/'\nInterval = '1m'\n",
  ] {
    let assert Err(err) = parse(f"{config}{settings}".bytes())
    assert !err.Error().contains("example-secret")
  }
  assert parse(
    "[server]\nauth = 'none'\n[server.checks.'bad/name']\nurl = 'http://example.test/'\n".bytes(),
  ).is_err()
}

#[test]
fn loading_config_never_reads_secrets_or_creates_state() -> Result<(), error> {
  let dir = os.MkdirTemp("", "vigilo-config-")?
  defer {
    let _ = os.RemoveAll(dir)
  }
  let config_path = filepath.Join(dir, "server.toml")
  let storage_path = filepath.Join(dir, "missing", "state.db")
  let contents = f"{minimal_server()}[server.storage]\npath = \"{storage_path}\"\n"
  os.WriteFile(config_path, contents.bytes(), 0o600)?
  let assert Config.Server(_) = load(config_path)?
  assert os.Stat(filepath.Join(dir, "missing")).is_err()
  let preserved_contents = os.ReadFile(config_path)? as string
  assert preserved_contents == contents
  assert load(filepath.Join(dir, "missing.toml")).is_err()
  Ok(())
}
