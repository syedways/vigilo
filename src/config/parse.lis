import "go:bytes"
import "go:errors"
import "go:github.com/pelletier/go-toml/v2"
import "go:strings"

import "agent"
import "secret"
import "server"

const DEFAULT_LISTEN = "127.0.0.1:8080"

const DEFAULT_STORAGE_PATH = "/var/lib/vigilo/vigilo.db"

pub enum Config {
  Server(server.Config),
  Agent(agent.Config),
  Both { server: server.Config, agent: agent.Config },
}

#[toml]
struct SectionsInput { server: ServerInput, agent: AgentInput }

#[toml]
struct ServerInput {
  listen: string,
  auth: string,
  storage: StorageInput,
  admin: AdminInput,
  tls: TlsInput,
  checks: Map<string, CheckInput>,
  agents: Map<string, TokenInput>,
}

#[toml]
struct CheckInput { url: string, interval: string }

#[toml]
struct TlsInput { certificate_file: string, key_file: string }

#[toml]
struct StorageInput { path: string }

#[toml]
struct AdminInput {
  username: string,
  password_file: string,
  password_credential: string,
}

#[toml]
struct AgentInput {
  name: string,
  server_url: string,
  token_file: string,
  token_credential: string,
}

#[toml]
struct TokenInput { token_file: string, token_credential: string }

fn parse(contents: Slice<byte>) -> Result<Config, error> {
  // keep exact key spelling and distinguish missing secret selectors from empty ones.
  let mut fields = Map.new<string, Unknown>()
  toml
    .Unmarshal(contents, &fields)
    .map_err(decode_error)
    .wrap_err("decode TOML")?
  validate_keys(fields).wrap_err("decode config")?

  let mut input = SectionsInput {
    server: ServerInput {
      listen: DEFAULT_LISTEN,
      auth: "password",
      storage: StorageInput { path: DEFAULT_STORAGE_PATH },
      ..,
    },
    ..,
  }
  let mut decoder = toml.NewDecoder(bytes.NewReader(contents))
  decoder.DisallowUnknownFields()
  decoder
    .Decode(&input)
    .map_err(decode_error)
    .wrap_err("decode config sections")?
  let server_settings = match fields.get("server") {
    Some(value) => {
      let table = require_table(value, "server must be a table")?
      Some(validate_server(input.server, table).wrap_err("server config")?)
    },
    None => None,
  }
  let agent_settings = if let Some(value) = fields.get("agent") {
    let table = require_table(value, "agent must be a table")?
    Some(validate_agent(input.agent, table)?)
  } else {
    None
  }
  match (server_settings, agent_settings) {
    (Some(server_config), Some(agent_config)) => Ok(
      Config.Both { server: server_config, agent: agent_config },
    ),
    (Some(settings), None) => Ok(Config.Server(settings)),
    (None, Some(settings)) => Ok(Config.Agent(settings)),
    (None, None) => Err(errors.New("config requires a server or agent section")),
  }
}

fn decode_error(err: error) -> error {
  if let Some(failure) = assert_type<Ref<toml.DecodeError>>(err) {
    let (line, column) = failure.Position()
    return errors.New(f"invalid TOML at line {line}, column {column}")
  }
  if assert_type<Ref<toml.StrictMissingError>>(err).is_some() {
    return errors.New("unknown config field")
  }
  errors.New("invalid TOML value")
}

fn validate_keys(fields: Map<string, Unknown>) -> Result<(), error> {
  for (key, value) in fields {
    if key != strings.ToLower(key) {
      return Err(errors.New("config keys must be lowercase"))
    }
    if let Some(table) = assert_type<Map<string, Unknown>>(value) {
      validate_keys(table)?
    }
  }
  Ok(())
}

fn validate_agent(
  input: AgentInput,
  fields: Map<string, Unknown>,
) -> Result<agent.Config, error> {
  let machine_name = input.name
  let has_reporting = ["server_url", "token_file", "token_credential"].any(
    |key| fields.get(key).is_some(),
  )
  if !has_reporting {
    validate_name(machine_name, "agent.name")?
    return Ok(agent.Config { machine_name, reporting: None })
  }
  agent.validate_name(machine_name).wrap_err("agent.name")?
  let endpoint = agent.reporting_url(input.server_url)?
  let token = select_source(fields, "token", "agent.token")?
  Ok(
    agent.Config {
      machine_name,
      reporting: Some(agent.Reporting { endpoint, token }),
    },
  )
}

fn validate_server(
  input: ServerInput,
  fields: Map<string, Unknown>,
) -> Result<server.Config, error> {
  let storage_path = input.storage.path
  secret.validate_absolute_path(storage_path, "storage.path")?
  let auth = match input.auth {
    "password" => {
      let source = select_password(fields)?
      let username = input.admin.username
      validate_name(username, "admin.username")?
      if strings.ContainsRune(username, ':') {
        return Err(errors.New("admin.username must not contain a colon"))
      }
      server.AuthConfig.Password { username, source }
    },
    "none" => {
      if fields.get("admin").is_some() {
        return Err(errors.New("omit server.admin when server.auth is none"))
      }
      server.AuthConfig.Disabled
    },
    _ => return Err(errors.New("server.auth must be password or none")),
  }
  let tls = if fields.get("tls").is_some() {
    Some(
      server.TlsFiles {
        certificate_file: input.tls.certificate_file,
        key_file: input.tls.key_file,
      },
    )
  } else {
    None
  }
  let mut checks = Map.new<string, server.HttpCheck>()
  for (name, check) in input.checks {
    checks[name] = server.parse_http_check(name, check.url, check.interval)?
  }
  let mut agents = Map.new<string, secret.Source>()
  if let Some(value) = fields.get("agents") {
    let table = require_table(value, "server.agents must be a table")?
    for (name, value) in table {
      agent.validate_name(name).wrap_err("server.agents")?
      let entry = require_table(value, "agent registration must be a table")?
      agents[name] = select_source(
        entry,
        "token",
        f"server.agents.{name}.token",
      )?
    }
  }
  let settings = server.Config {
    listen: input.listen,
    storage_path,
    auth,
    tls,
    checks,
    agents,
  }
  server.validate_endpoint(settings)?
  Ok(settings)
}

fn select_password(fields: Map<string, Unknown>) -> Result<secret.Source, error> {
  let admin_value = fields
    .get("admin")
    .ok_or_else(|| errors.New("admin settings are required"))?
  let admin_fields = require_table(admin_value, "admin must be a table")?
  select_source(admin_fields, "password", "admin.password")
}

fn require_table(
  value: Unknown,
  message: string,
) -> Result<Map<string, Unknown>, error> {
  assert_type<Map<string, Unknown>>(value).ok_or_else(|| errors.New(message))
}

fn validate_name(name: string, field: string) -> Result<(), error> {
  if strings.TrimSpace(name).is_empty() || strings.ContainsAny(name, "\r\n\0") {
    return Err(errors.New(
      f"{field} must be nonempty and contain no newline or NUL",
    ))
  }
  Ok(())
}

fn select_source(
  fields: Map<string, Unknown>,
  key: string,
  field: string,
) -> Result<secret.Source, error> {
  let file_key = f"{key}_file"
  let credential_key = f"{key}_credential"
  let (value, make_source) = match (
    fields.get(file_key),
    fields.get(credential_key),
  ) {
    (Some(value), None) => (value, secret.Source.File),
    (None, Some(value)) => (value, secret.Source.Credential),
    _ => return Err(errors.New(
      f"{field} requires exactly one of {file_key} or {credential_key}",
    )),
  }
  let Some(path) = assert_type<string>(value) else {
    return Err(errors.New(f"{field} source must be a string"))
  }
  let source = make_source(path)
  secret.validate(source, field)?
  Ok(source)
}
