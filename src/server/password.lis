import "go:bytes"
import "go:errors"
import "go:io"
import "go:os"
import "go:path/filepath"
import "go:strings"

const MAX_PASSWORD_BYTES = 1024

pub enum SecretSource {
  File(string),
  Credential(string),
}

pub fn validate_password_source(source: SecretSource) -> Result<(), error> {
  match source {
    SecretSource.File(path) => validate_absolute_path(
      path,
      "admin.password_file",
    ),
    SecretSource.Credential(name) => validate_credential(name),
  }
}

pub fn read_password(
  source: SecretSource,
  credentials_dir: string,
) -> Result<Slice<byte>, error> {
  validate_password_source(source)?
  let path = match source {
    SecretSource.File(path) => path,
    SecretSource.Credential(name) => {
      validate_absolute_path(credentials_dir, "CREDENTIALS_DIRECTORY")?
      filepath.Join(credentials_dir, name)
    },
  }
  let file = os.Open(path).wrap_err("open admin password")?
  defer file.Close()
  // allow a final CRLF and read one extra byte to detect overflow
  let limit = (MAX_PASSWORD_BYTES + 3) as int64
  let data = match io.ReadAll(io.LimitReader(file, limit)) {
    Partial.Ok(data) => data,
    Partial.Err(err) | Partial.Both(_, err) => {
      return Err(err).wrap_err("read admin password")
    },
  }
  parse_password_file(data)
}

fn parse_password_file(contents: Slice<byte>) -> Result<Slice<byte>, error> {
  let password = bytes
    .CutSuffix(contents, "\r\n".bytes())
    .unwrap_or_else(|| {
      bytes.TrimSuffix(contents, "\n".bytes())
    })
  if password.is_empty() || password.length() > MAX_PASSWORD_BYTES {
    return Err(errors.New(
      f"admin password must contain 1 to {MAX_PASSWORD_BYTES} bytes",
    ))
  }
  if bytes.ContainsAny(password, "\r\n\0") {
    return Err(errors.New(
      "admin password must contain no embedded newline or NUL",
    ))
  }
  Ok(password)
}

fn validate_absolute_path(path: string, field: string) -> Result<(), error> {
  if !filepath.IsAbs(path) || strings.ContainsRune(path, '\0') {
    return Err(errors.New(f"{field} must be an absolute path without NUL"))
  }
  Ok(())
}

fn validate_credential(name: string) -> Result<(), error> {
  if name == "" || name == "." || name == ".." {
    return Err(errors.New("admin.password_credential must be a credential name"))
  }
  let allowed = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._-"
  let invalid = strings.IndexFunc(name, |ch| !strings.ContainsRune(allowed, ch))
  if invalid.is_some() {
    return Err(errors.New(
      "admin.password_credential may contain only ASCII letters, digits, dots, underscores, and hyphens",
    ))
  }
  Ok(())
}
