import "go:net/http"
import "go:net/http/httptest"
import "go:os"
import "go:path/filepath"
import "go:time"

#[test]
fn password_auth_loads_once_and_matches_the_exact_secret() -> Result<(), error> {
  let dir = os.MkdirTemp("", "vigilo-admin-auth-")?
  defer {
    let _ = os.RemoveAll(dir)
  }
  let path = filepath.Join(dir, "admin-password")
  let config = AuthConfig.Password {
    username: "operator",
    source: SecretSource.File(path),
  }
  for short in ["12345", "ééééé"] {
    os.WriteFile(path, f"{short}\r\n".bytes(), 0o600)?
    let assert Err(err) = load_auth(config, "")
    assert err.Error() == "admin password must contain at least 6 characters"
  }
  for accepted in ["123456", "aaaaaa", "éééééé", "operator"] {
    os.WriteFile(path, f"{accepted}\n".bytes(), 0o600)?
    assert load_auth(config, "").is_ok()
  }

  let password = " pebbles:lantern:fen "
  os.WriteFile(path, f"{password}\r\n".bytes(), 0o600)?
  let auth = load_auth(config, "")?
  os.WriteFile(path, "new-secret-fern-cloud\n".bytes(), 0o600)?
  let handler = Handler { auth, overview: new_overview(time.Now())? }

  for (username, supplied, code) in [
    ("operator", password, http.StatusNotFound),
    ("operator", "pebbles:lantern:fen", http.StatusUnauthorized),
    ("operator", "new-secret-fern-cloud", http.StatusUnauthorized),
    ("admin", password, http.StatusUnauthorized),
  ] {
    let mut request = httptest.NewRequest("GET", "/private", None)
    request.SetBasicAuth(username, supplied)
    let mut response = httptest.NewRecorder()
    handler.ServeHTTP(response, request)
    assert response.Code == code
  }
  let rotated = load_auth(config, "")?
  let mut request = httptest.NewRequest("GET", "/private", None)
  request.SetBasicAuth("operator", "new-secret-fern-cloud")
  assert permits(rotated, request)
  Ok(())
}

#[test]
fn disabled_auth_skips_secrets_and_health_is_public() -> Result<(), error> {
  let mut request = httptest.NewRequest("GET", "/healthz", None)
  let mut response = httptest.NewRecorder()
  let enabled = Handler {
    auth: Auth.Password { username: "operator", key: [], digest: [] },
    overview: new_overview(time.Now())?,
  }
  enabled.ServeHTTP(response, request)
  assert response.Code == http.StatusOK
  let mut request = httptest.NewRequest("GET", "/private", None)
  let mut response = httptest.NewRecorder()
  enabled.ServeHTTP(response, request)
  assert response.Code == http.StatusUnauthorized
  assert response.Header().Get("WWW-Authenticate").contains("Basic realm=")
  let disabled = Handler {
    auth: load_auth(AuthConfig.Disabled, "")?,
    overview: new_overview(time.Now())?,
  }
  for (host, code) in [
    ("localhost", http.StatusNotFound),
    ("127.0.0.1:8080", http.StatusNotFound),
    ("[::1]", http.StatusNotFound),
    ("[::1]:8080", http.StatusNotFound),
    ("example.com", http.StatusForbidden),
    ("localhost.example.com", http.StatusForbidden),
    ("192.0.2.1:8080", http.StatusForbidden),
  ] {
    let mut response = httptest.NewRecorder()
    request.Host = host
    disabled.ServeHTTP(response, request)
    assert response.Code == code
  }
  Ok(())
}
