import "go:context"
import "go:crypto/tls"
import "go:encoding/json"
import "go:errors"
import "go:fmt"
import "go:html/template"
import "go:net"
import "go:net/http"
import "go:strings"
import "go:time"

import "storage"

pub fn run(
  ctx: context.Context,
  settings: Config,
  credentials_dir: string,
) -> Result<(), error> {
  validate_endpoint(settings)?
  let auth = load_auth(settings.auth, credentials_dir)?
  let tls_settings = match settings.tls {
    Some(files) => {
      let certificate = tls
        .LoadX509KeyPair(files.certificate_file, files.key_file)
        .wrap_err("load server TLS certificate and key")?
      Some(
        tls.Config {
          Certificates: [certificate],
          MinVersion: tls.VersionTLS12 as uint16,
          NextProtos: ["h2", "http/1.1"],
          ..,
        },
      )
    },
    None => None,
  }
  let socket = net.Listen("tcp", settings.listen).wrap_err("listen")?
  defer socket.Close()
  let (listener, scheme) = tls_settings.map_or((socket, "http"), |config| {
    (tls.NewListener(socket, &config), "https")
  })
  let mut handler = new_handler(auth)?
  let checks = settings.checks
  if checks.is_empty() { return serve_http(ctx, listener, handler, scheme) }

  let mut db = storage
    .open(settings.storage_path)
    .wrap_err("open check history")?
  defer db.Close()
  let (checks_ctx, stop_checks) = context.WithCancel(ctx)
  let finished = Channel.buffered<()>(checks.length())
  defer {
    // wait for every worker before closing the database.
    stop_checks()
    for _ in 0..checks.length() {
      let _ = finished.receive()
    }
  }
  for (name, check) in checks {
    task {
      run_check(checks_ctx, db, name, check)
      let _ = finished.send(())
    }
  }
  handler.history = Some(
    History {
      recent: |request_ctx, name, limit| storage.recent(
        db,
        request_ctx,
        name,
        limit,
      ),
      checks,
    },
  )
  serve_http(ctx, listener, handler, scheme)
}

fn serve_http(
  ctx: context.Context,
  listener: net.Listener,
  handler: Handler,
  scheme: string,
) -> Result<(), error> {
  let Some(address) = listener.Addr() else {
    return Err(errors.New("listener has no address"))
  }
  let mut server = http.Server {
    Handler: Some(handler),
    ReadHeaderTimeout: 5 * time.Second,
    ReadTimeout: 10 * time.Second,
    WriteTimeout: 10 * time.Second,
    IdleTimeout: 60 * time.Second,
    MaxHeaderBytes: 16 * 1024,
    ..,
  }
  defer server.Close()
  let finished = Channel.buffered<Result<(), error>>(1)
  task {
    let _ = finished.send(server.Serve(listener))
  }
  fmt.Println(f"server: listening on {scheme}://{address.String()}")
  select {
    match finished.receive() {
      Some(result) => result,
      None => Err(errors.New("HTTP task stopped without a result")),
    },
    match ctx.Done().receive() {
      Some(_) => Err(errors.New(
        "unexpected value on context cancellation channel",
      )),
      None => {
        let (shutdown_ctx, cancel) = context.WithTimeout(
          context.Background(),
          5 * time.Second,
        )
        defer cancel()
        server.Shutdown(shutdown_ctx).wrap_err("HTTP shutdown")?
        let Some(result) = finished.receive() else {
          return Err(errors.New("HTTP task stopped without a result"))
        }
        match result {
          Ok(()) => Ok(()),
          Err(err) if errors.Is(err, http.ErrServerClosed) => Ok(()),
          Err(err) => Err(err),
        }
      },
    },
  }
}

struct Handler {
  auth: Auth,
  overview: Overview,
  checks_page: Ref<template.Template>,
  history: Option<History>,
}

struct History {
  recent: fn(context.Context, string, int) -> Result<Slice<storage.Sample>, error>,
  checks: Map<string, HttpCheck>,
}

fn new_handler(auth: Auth) -> Result<Handler, error> {
  let overview = new_overview(time.Now())?
  let checks_page = parse_page(CHECKS_CONTENT)?
  Ok(Handler { auth, overview, checks_page, history: None })
}

impl Handler {
  fn ServeHTTP(
    self,
    response: http.ResponseWriter,
    request: mut Ref<http.Request>,
  ) {
    if let Auth.Disabled = self.auth {
      if !is_loopback_host(request.Host) {
        http.Error(response, "forbidden host", http.StatusForbidden)
        return
      }
    }
    let Some(url) = request.URL else {
      http.NotFound(response, request)
      return
    }
    if url.Path != "/healthz" && !permits(self.auth, request) {
      response
        .Header()
        .Set("WWW-Authenticate", "Basic realm=\"Vigilo\", charset=\"UTF-8\"")
      http.Error(response, "unauthorized", http.StatusUnauthorized)
      return
    }
    match url.Path {
      "/" => {
        if allow_get(response, request.Method) {
          serve_overview(self.overview, response)
        }
      },
      "/checks" => {
        if allow_get(response, request.Method) {
          let name = url.Query().Get("check")
          serve_checks(self.checks_page, self.history, response, request, name)
        }
      },
      "/healthz" => {
        if allow_get(response, request.Method) {
          response.Header().Set("Content-Type", "text/plain; charset=utf-8")
          let _ = fmt.Fprintln(response, "ok")
        }
      },
      _ => {
        let Some(history) = self.history else {
          http.NotFound(response, request)
          return
        }
        serve_history(history, response, request, url.Path)
      },
    }
  }
}

fn allow_get(response: http.ResponseWriter, method: string) -> bool {
  if method == "GET" { return true }
  response.Header().Set("Allow", "GET")
  http.Error(response, "method not allowed", http.StatusMethodNotAllowed)
  false
}

fn serve_history(
  history: History,
  response: http.ResponseWriter,
  request: mut Ref<http.Request>,
  path: string,
) {
  let ["", "api", "checks", name, "history"] = strings.Split(path, "/") else {
    http.NotFound(response, request)
    return
  }
  if history.checks.get(name).is_none() {
    http.NotFound(response, request)
    return
  }
  if !allow_get(response, request.Method) { return }
  let Ok(samples) = (history.recent)(
    request.Context(),
    name,
    storage.HISTORY_LIMIT,
  ) else {
    http.Error(
      response,
      "check history unavailable",
      http.StatusServiceUnavailable,
    )
    return
  }
  response.Header().Set("Content-Type", "application/json")
  response.Header().Set("Cache-Control", "no-store")
  let _ = json.NewEncoder(response).Encode(samples)
}

fn is_loopback_host(authority: string) -> bool {
  let host = match net.SplitHostPort(authority) {
    Ok((host, _)) => host,
    Err(_) => strings.TrimSuffix(strings.TrimPrefix(authority, "["), "]"),
  }
  strings.EqualFold(host, "localhost") || is_loopback_ip(host)
}
