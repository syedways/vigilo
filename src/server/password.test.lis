import "go:bytes"
import "go:os"
import "go:path/filepath"
import "go:strings"

#[test]
fn password_file_parser_preserves_other_whitespace() {
  for contents in [" secret \t", " secret \t\n", " secret \t\r\n"] {
    let assert Ok(password) = parse_password_file(contents.bytes())
    assert bytes.Equal(password, " secret \t".bytes())
  }
  let assert Ok(password) = parse_password_file(" \n".bytes())
  assert bytes.Equal(password, " ".bytes())
  assert parse_password_file(strings.Repeat("a", 1024).bytes()).is_ok()
  assert parse_password_file(f"{strings.Repeat("a", 1024)}\r\n".bytes()).is_ok()
  let raw: Slice<byte> = [255, 254, 10]
  let expected: Slice<byte> = [255, 254]
  let assert Ok(password) = parse_password_file(raw)
  assert bytes.Equal(password, expected)
}

#[test]
fn rejects_empty_oversized_multiline_and_nul_passwords() {
  let nul_bytes: Slice<byte> = [115, 0, 115]
  for contents in [
    "",
    "\n",
    "\r\n",
    "secret\r",
    "secret\n\n",
    "secret\r\n\r\n",
    "first\nsecond",
    "first\rsecond",
    strings.Repeat("a", 1025),
  ] {
    assert parse_password_file(contents.bytes()).is_err()
  }
  assert parse_password_file(nul_bytes).is_err()
}

#[test]
fn reads_files_and_named_credentials_with_a_size_limit() -> Result<(), error> {
  let dir = os.MkdirTemp("", "vigilo-secret-")?
  defer {
    let _ = os.RemoveAll(dir)
  }
  let password_path = filepath.Join(dir, "admin-password")
  os.WriteFile(password_path, " secret \t\r\n".bytes(), 0o600)?
  let file_password = read_password(SecretSource.File(password_path), "")?
  let credential_password = read_password(
    SecretSource.Credential("admin-password"),
    dir,
  )?
  assert bytes.Equal(file_password, " secret \t".bytes())
  assert bytes.Equal(credential_password, " secret \t".bytes())
  os.WriteFile(password_path, f"{strings.Repeat("a", 1024)}\r\n".bytes(), 0o600)?
  let max_password = read_password(SecretSource.File(password_path), "")?
  assert max_password.length() == 1024
  os.WriteFile(password_path, strings.Repeat("a", 100000).bytes(), 0o600)?
  assert read_password(SecretSource.File(password_path), "").is_err()
  Ok(())
}

#[test]
fn secret_file_and_credential_errors_fail_startup() -> Result<(), error> {
  let dir = os.MkdirTemp("", "vigilo-secret-errors-")?
  defer {
    let _ = os.RemoveAll(dir)
  }
  let password_path = filepath.Join(dir, "password")
  assert read_password(SecretSource.File(password_path), "").is_err()
  assert read_password(SecretSource.File(dir), "").is_err()
  assert read_password(SecretSource.File("relative"), "").is_err()
  assert read_password(SecretSource.Credential("password"), "").is_err()
  assert read_password(SecretSource.Credential("../password"), dir).is_err()
  os.WriteFile(password_path, "".bytes(), 0o600)?
  assert read_password(SecretSource.File(password_path), "").is_err()
  os.WriteFile(password_path, "secret".bytes(), 0o000)?
  os.Chmod(password_path, 0o000)?
  assert read_password(SecretSource.File(password_path), "").is_err()
  Ok(())
}

#[test]
fn credential_names_cannot_escape_the_credentials_dir() {
  for name in ["admin-password", "admin.password_1"] {
    assert validate_credential(name).is_ok()
  }
  for name in [
    "",
    ".",
    "..",
    "../password",
    "/password",
    "nested/password",
    "bad name",
    "bad\nname",
    "é",
  ] {
    assert validate_credential(name).is_err()
  }
}
