import "go:errors"
import "go:net"
import "go:net/netip"
import "go:net/url"
import "go:strconv"
import "go:strings"
import "go:time"

pub struct Config {
  pub listen: string,
  pub storage_path: string,
  pub auth: AuthConfig,
  pub tls: Option<TlsFiles>,
  pub checks: Map<string, HttpCheck>,
}

pub struct HttpCheck { url: string, interval: time.Duration }

pub fn parse_http_check(
  name: string,
  endpoint: string,
  interval: string,
) -> Result<HttpCheck, error> {
  let invalid_name_char = strings.ContainsFunc(name, |ch| {
    let letter = ch >= 'a' && ch <= 'z'
    let digit = ch >= '0' && ch <= '9'
    !(letter || digit || ch == '-' || ch == '_')
  })
  if name.is_empty() || invalid_name_char {
    return Err(errors.New(
      "check names must contain only lowercase ASCII letters, digits, hyphens, or underscores",
    ))
  }
  let parsed = url
    .Parse(endpoint)
    .map_err(|_| errors.New("check URL must be a valid HTTP or HTTPS URL"))?
  let http_scheme = parsed.Scheme == "http" || parsed.Scheme == "https"
  if !http_scheme || parsed.Hostname().is_empty() || parsed.User.is_some() || parsed.Fragment != "" {
    return Err(errors.New(
      "check URL requires an HTTP or HTTPS host and must omit credentials and fragments",
    ))
  }
  let delay = if interval == "" {
    time.Minute
  } else {
    time
      .ParseDuration(interval)
      .map_err(|_| errors.New("check interval must be a duration such as 1m"))?
  }
  if delay < time.Second {
    return Err(errors.New("check interval must be at least 1s"))
  }
  Ok(HttpCheck { url: parsed.String(), interval: delay })
}

pub struct TlsFiles {
  pub certificate_file: string,
  pub key_file: string,
}

pub enum AuthConfig {
  Password { username: string, source: SecretSource },
  Disabled,
}

pub fn validate_endpoint(settings: Config) -> Result<(), error> {
  validate_listen(settings.listen)?
  if let Some(files) = settings.tls {
    validate_absolute_path(
      files.certificate_file,
      "server.tls.certificate_file",
    )?
    validate_absolute_path(files.key_file, "server.tls.key_file")?
  }
  let (host, _) = net.SplitHostPort(settings.listen)?
  if is_loopback_ip(host) { return Ok(()) }
  if settings.auth == AuthConfig.Disabled {
    return Err(errors.New(
      "server.listen must use a loopback IP when auth is none",
    ))
  }
  if settings.tls.is_none() {
    return Err(errors.New("server.listen must use a loopback IP without TLS"))
  }
  Ok(())
}

fn is_loopback_ip(host: string) -> bool {
  netip
    .ParseAddr(host)
    .map_or(false, |ip| ip.Zone() == "" && ip.Unmap().IsLoopback())
}

pub fn validate_listen(address: string) -> Result<(), error> {
  let (host, port_text) = net
    .SplitHostPort(address)
    .wrap_err("server.listen must be host:port")?
  if strings.ContainsAny(host, " \t\r\n/\0") {
    return Err(errors.New("server.listen has an invalid host"))
  }
  if host.contains(":") && (strings.Count(host, "%") > 1 ||
  netip.ParseAddr(host).is_err()) {
    return Err(errors.New("server.listen has an invalid IPv6 address"))
  }
  let _ = strconv
    .ParseUint(port_text, 10, 16)
    .wrap_err("server.listen requires a decimal port from 0 to 65535")?
  Ok(())
}
