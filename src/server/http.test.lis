import "go:context"
import "go:os"
import "go:path/filepath"

#[test]
fn invalid_tls_files_fail_server_startup() -> Result<(), error> {
  let dir = os.MkdirTemp("", "vigilo-tls-")?
  defer {
    let _ = os.RemoveAll(dir)
  }
  let certificate_file = filepath.Join(dir, "cert.pem")
  let key_file = filepath.Join(dir, "key.pem")
  let settings = Config {
    listen: "127.0.0.1:0",
    storage_path: filepath.Join(dir, "state.db"),
    auth: AuthConfig.Disabled,
    tls: Some(TlsFiles { certificate_file, key_file }),
  }
  let assert Err(missing) = run(context.Background(), settings, "")
  assert missing.Error().contains("load server TLS certificate and key")
  os.WriteFile(certificate_file, "invalid certificate".bytes(), 0o600)?
  os.WriteFile(key_file, "invalid key".bytes(), 0o600)?
  let assert Err(invalid) = run(context.Background(), settings, "")
  assert invalid.Error().contains("load server TLS certificate and key")
  Ok(())
}
