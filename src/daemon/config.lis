import "go:errors"

import "config"

fn config_command() -> Command {
  Command {
    name: "config",
    desc: "manage config",
    action: Action.Group([
      Command {
        name: "check",
        desc: f"validate config using [path], then VIGILO_CONFIG_PATH, then {config.SYSTEM_CONFIG_PATH}",
        action: Action.Run { args_usage: "[path]", handler: config_check },
      },
    ]),
  }
}

fn config_check(args: Slice<string>) -> Result<(), error> {
  let path = match args {
    [] => config.default_path(),
    [path] => path,
    _ => return Err(errors.New("expected at most one path")),
  }
  let _ = config.load(path)?
  Ok(())
}
