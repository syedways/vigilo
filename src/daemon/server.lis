import "go:context"
import "go:errors"
import "go:os"
import "go:os/signal"
import "go:syscall"

import "config"
import "server"

fn server_command() -> Command {
  Command {
    name: "server",
    desc: "Start the Vigilo server",
    action: Action.Run {
      args_usage: "[path]",
      details: config_lookup_help(),
      handler: run_server,
    },
  }
}

fn run_server(args: Slice<string>) -> Result<(), error> {
  let path = config_path(args)?
  let settings = match config.load(path)? {
    config.Config.Server(settings) | config.Config.Both { server: settings, .. } => settings,
    config.Config.Agent(_) => return Err(errors.New(
      f"validate config {path}: requires a server section",
    )),
  }
  let (ctx, stop) = signal.NotifyContext(
    context.Background(),
    os.Interrupt,
    syscall.SIGTERM,
  )
  defer stop()
  server.run(ctx, settings, os.Getenv("CREDENTIALS_DIRECTORY"))
}
