import "go:os"

import "config"

#[test]
fn config_check_path_precedence() -> Result<(), error> {
  let dir = os.MkdirTemp("", "vigilo-config-check-")?
  defer {
    let _ = os.RemoveAll(dir)
  }
  let cwd = os.Getwd()?
  os.Chdir(dir)?
  defer {
    let _ = os.Chdir(cwd)
  }

  let key = "VIGILO_CONFIG_PATH"
  let original = os.LookupEnv(key)
  defer {
    let _ = match original {
      Some(value) => os.Setenv(key, value),
      None => os.Unsetenv(key),
    }
  }

  let valid = "[agent]\nname = \"dev\"\n".bytes()
  os.WriteFile("explicit.toml", valid, 0o600)?
  let args = ["config", "check"]

  os.Unsetenv(key)?
  assert config.default_path() == "/etc/vigilo/vigilo.toml"
  os.Setenv(key, "")?
  assert config.default_path() == "/etc/vigilo/vigilo.toml"

  os.Setenv(key, "override.toml")?
  let assert Err(err) = run("vigilo", args)
  assert err.Error().contains("override.toml")
  assert !err.Error().contains("Hint:")
  let assert Ok(None) = run("vigilo", args.append("explicit.toml"))

  os.WriteFile("override.toml", valid, 0o600)?
  let assert Ok(None) = run("vigilo", args)
  os.WriteFile("invalid.toml", "[server]\nauth = \"invalid\"\n".bytes(), 0o600)?
  let assert Err(invalid) = run("vigilo", args.append("invalid.toml"))
  assert invalid.Error().contains("validate config invalid.toml")
  Ok(())
}

#[test]
fn help_lists_immediate_commands_and_keeps_lookup_order_on_leaves() {
  let assert Ok(Some(root)) = run("vigilo", ["--help"])
  assert root.contains("  config  Manage configuration")
  assert root.contains("  server  Start the Vigilo server")
  assert !root.contains("  check ")
  assert !root.contains("VIGILO_CONFIG_PATH")
  assert root.contains("vigilo <command> --help")

  let assert Ok(Some(group)) = run("vigilo", ["config", "--help"])
  assert group.contains("  check  Validate a configuration file")
  assert !group.contains("VIGILO_CONFIG_PATH")
  assert group.contains("vigilo config <command> --help")

  let lookup = "[path], then nonempty VIGILO_CONFIG_PATH, then /etc/vigilo/vigilo.toml"
  let assert Ok(Some(check)) = run("vigilo", ["config", "check", "--help"])
  let assert Ok(Some(server)) = run("vigilo", ["server", "--help"])
  assert check.contains(lookup)
  assert server.contains(lookup)
}
