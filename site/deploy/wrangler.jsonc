{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vigilo",
  "compatibility_date": "2026-11-18",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true, "traces": { "enabled": true } },
  "assets": {
    "directory": "../dist",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page"
  }
}
